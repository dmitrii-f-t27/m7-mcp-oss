// Added by Dmitrii Fedorov, 2026; not part of the original M7 MCP. Apache-2.0 (see NOTICE).
; Peer-text rules, moved from src/mesh/peerText.ts (SEC-7). Text from another workstation or peer is data, not
; instruction. Before it reaches the model it is cleaned: every control character becomes a space, the fence marks
; "<<<" and ">>>" are broken (a space goes in front of every third angle bracket in a row), and the text can be put
; between <<< and >>> marks. The TypeScript at c41f8ce stays as the test oracle (tests/oracles/peerTextLegacy.mjs).
; Text is UTF-8 bytes in a buffer, always well-formed (the host replaces a lone surrogate with U+FFFD first, because
; UTF-8 cannot carry one) and with its true length. The rules count in UTF-16 units where the TypeScript did: a
; character above U+FFFF is two units, any other is one. A cut never splits a character.
; Limits: the input is at most MR_TEXT_MAX bytes (3 MiB: the relay allows a body of 1,048,576 UTF-16 units, which
; can be 3 MiB of UTF-8). The output is at most MR_OUT_MAX bytes: 1.5 times the input plus 16, because a run of angle
; brackets gains one space for every second bracket and the marks add a few bytes. A text over the limit is not cut:
; the functions answer MR_ERR_LIMIT and the host shows the refusal text of mr_refusal.
; Answers: the length of the output in bytes, or a negative code. MR_ERR_TEXT: the bytes are not well-formed UTF-8.
; MR_ERR_LIMIT: the length is not allowed, or the output would not fit.
module MeshRules;

pub const MR_TEXT_MAX : i32 = 3145728;
pub const MR_OUT_MAX : i32 = 4718608;
pub const MR_FENCE_RUN : i32 = 3;
pub const MR_ID_UNITS : i32 = 12;
pub const MR_ERR_TEXT : i32 = -1;
pub const MR_ERR_LIMIT : i32 = -2;
pub const MR_REFUSAL_LEN : i32 = 40;

pub const MR_SPACE : u8 = 32;
pub const MR_LT : u8 = 60;
pub const MR_GT : u8 = 62;
pub const MR_LF : u8 = 10;
pub const MR_DOT : u8 = 46;

; "[peer text refused: over the size limit]"
pub const MR_REFUSAL : [40]u8 = [91, 112, 101, 101, 114, 32, 116, 101, 120, 116, 32, 114, 101, 102, 117, 115, 101, 100, 58, 32, 111, 118, 101, 114, 32, 116, 104, 101, 32, 115, 105, 122, 101, 32, 108, 105, 109, 105, 116, 93];

; Is this Unicode code point a control? C0 controls and DEL, C1 controls (U+0080 to U+009F), zero-width space and
; joiners and the left-to-right and right-to-left marks (U+200B to U+200F), the line and paragraph separators
; (U+2028, U+2029), bidi controls (U+202A to U+202E, U+2066 to U+2069), the byte order mark (U+FEFF), tag characters
; (U+E0000 to U+E007F), and the other invisible marks: soft hyphen (U+00AD), combining grapheme joiner (U+034F),
; Arabic letter mark (U+061C), Mongolian vowel separator (U+180E), the word joiner block (U+2060 to U+2065) and
; the interlinear annotation marks (U+FFF9 to U+FFFB). With keep, line feed and tab are not controls.
pub fn mr_is_control(code: i32, keep: bool) -> bool {
    if (code == 10 or code == 9) { return !keep; }
    if (code < 32 or (code >= 127 and code <= 159)) { return true; }
    if (code >= 8203 and code <= 8207) { return true; }
    if (code == 8232 or code == 8233) { return true; }
    if (code >= 8234 and code <= 8238) { return true; }
    if (code >= 8294 and code <= 8297) { return true; }
    if (code == 65279) { return true; }
    if (code >= 917504 and code <= 917631) { return true; }
    if (code == 173 or code == 847 or code == 1564 or code == 6158) { return true; }
    if (code >= 8288 and code <= 8293) { return true; }
    if (code >= 65529 and code <= 65531) { return true; }
    return false;
}

; Is this byte a continuation byte of a UTF-8 character (10xxxxxx)?
fn mr_is_cont(b: i32) -> bool {
    if (b >= 128 and b <= 191) { return true; }
    return false;
}

; The width in bytes of the well-formed UTF-8 character at place at, or MR_ERR_TEXT. No overlong form, no surrogate,
; nothing above U+10FFFF, and the whole character inside the text.
fn mr_valid_width(input: [MR_TEXT_MAX]u8, len: i32, at: i32) -> i32 {
    var lead: i32 = input[at];
    if (lead < 128) { return 1; }
    if (lead >= 194 and lead <= 223) {
        if (at + 2 > len) { return MR_ERR_TEXT; }
        if (mr_is_cont(input[at + 1])) { return 2; }
        return MR_ERR_TEXT;
    }
    if (lead >= 224 and lead <= 239) {
        if (at + 3 > len) { return MR_ERR_TEXT; }
        var low3: i32 = 128;
        var high3: i32 = 191;
        if (lead == 224) { low3 = 160; }
        if (lead == 237) { high3 = 159; }
        var second3: i32 = input[at + 1];
        if (second3 < low3 or second3 > high3) { return MR_ERR_TEXT; }
        if (mr_is_cont(input[at + 2])) { return 3; }
        return MR_ERR_TEXT;
    }
    if (lead >= 240 and lead <= 244) {
        if (at + 4 > len) { return MR_ERR_TEXT; }
        var low4: i32 = 128;
        var high4: i32 = 191;
        if (lead == 240) { low4 = 144; }
        if (lead == 244) { high4 = 143; }
        var second4: i32 = input[at + 1];
        if (second4 < low4 or second4 > high4) { return MR_ERR_TEXT; }
        if (mr_is_cont(input[at + 2]) and mr_is_cont(input[at + 3])) { return 4; }
        return MR_ERR_TEXT;
    }
    return MR_ERR_TEXT;
}

; The code point of the character of width w at place at (the bytes were checked by mr_valid_width).
fn mr_code_at(input: [MR_TEXT_MAX]u8, at: i32, w: i32) -> i32 {
    var b0: i32 = input[at];
    if (w == 1) { return b0; }
    var b1: i32 = input[at + 1];
    if (w == 2) { return (b0 - 192) * 64 + (b1 - 128); }
    var b2: i32 = input[at + 2];
    if (w == 3) { return (b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128); }
    var b3: i32 = input[at + 3];
    return (b0 - 240) * 262144 + (b1 - 128) * 4096 + (b2 - 128) * 64 + (b3 - 128);
}

; The width of a character in clean text (text this spec wrote, so well-formed) from its first byte.
fn mr_lead_width(b: i32) -> i32 {
    if (b < 224) { if (b < 192) { return 1; } return 2; }
    if (b < 240) { return 3; }
    return 4;
}

; Is there room for n more bytes in the output after o bytes?
fn mr_room(o: i32, n: i32) -> bool {
    if (o + n > MR_OUT_MAX) { return false; }
    return true;
}

; Clean text: every control becomes a space, and a space goes in front of every third angle bracket of a kind in
; a row, so the output holds neither "<<<" nor ">>>". With keep, line feed and tab stay. The output is out[0 .. n).
pub fn mr_scrub(input: [MR_TEXT_MAX]u8, len: i32, keep: bool, out: [MR_OUT_MAX]u8) -> i32 {
    if (len < 0 or len > MR_TEXT_MAX) { return MR_ERR_LIMIT; }
    var i: i32 = 0;
    var o: i32 = 0;
    var less: i32 = 0;
    var greater: i32 = 0;
    while (i < len) {
        var w: i32 = mr_valid_width(input, len, i);
        if (w < 0) { return MR_ERR_TEXT; }
        var code: i32 = mr_code_at(input, i, w);
        if (mr_is_control(code, keep)) {
            if (!mr_room(o, 1)) { return MR_ERR_LIMIT; }
            out[o] = MR_SPACE;
            o = o + 1;
            less = 0;
            greater = 0;
        } else {
            if (code == 60) {
                greater = 0;
                if (less == MR_FENCE_RUN - 1) {
                    if (!mr_room(o, 1)) { return MR_ERR_LIMIT; }
                    out[o] = MR_SPACE;
                    o = o + 1;
                    less = 0;
                }
                less = less + 1;
                if (!mr_room(o, 1)) { return MR_ERR_LIMIT; }
                out[o] = MR_LT;
                o = o + 1;
            } else {
                if (code == 62) {
                    less = 0;
                    if (greater == MR_FENCE_RUN - 1) {
                        if (!mr_room(o, 1)) { return MR_ERR_LIMIT; }
                        out[o] = MR_SPACE;
                        o = o + 1;
                        greater = 0;
                    }
                    greater = greater + 1;
                    if (!mr_room(o, 1)) { return MR_ERR_LIMIT; }
                    out[o] = MR_GT;
                    o = o + 1;
                } else {
                    less = 0;
                    greater = 0;
                    if (!mr_room(o, w)) { return MR_ERR_LIMIT; }
                    var k: i32 = 0;
                    while (k < w) {
                        out[o + k] = input[i + k];
                        k = k + 1;
                    }
                    o = o + w;
                }
            }
        }
        i = i + w;
    }
    return o;
}

; The length in bytes of the longest start of the clean text clean[0 .. len) that is at most max UTF-16 units and does
; not split a character. A character above U+FFFF is two units. The whole text if it fits.
pub fn mr_cut_units(clean: [MR_OUT_MAX]u8, len: i32, max: i32) -> i32 {
    if (len < 0 or len > MR_OUT_MAX or max < 0) { return MR_ERR_LIMIT; }
    var i: i32 = 0;
    var units: i32 = 0;
    while (i < len) {
        var w: i32 = mr_lead_width(clean[i]);
        var step: i32 = 1;
        if (w == 4) { step = 2; }
        if (units + step > max) { return i; }
        units = units + step;
        i = i + w;
    }
    return len;
}

; Put the clean text clean[0 .. len) between the <<< and >>> marks, in place. A space keeps the text from touching a
; mark. Returns the new length.
pub fn mr_wrap(clean: [MR_OUT_MAX]u8, len: i32) -> i32 {
    if (len < 0 or len > MR_OUT_MAX) { return MR_ERR_LIMIT; }
    var pre: i32 = 3;
    if (len > 0 and clean[0] == MR_LT) { pre = 4; }
    var post: i32 = 3;
    if (len > 0 and clean[len - 1] == MR_GT) { post = 4; }
    if (!mr_room(len, pre + post)) { return MR_ERR_LIMIT; }
    var i: i32 = len;
    while (i > 0) {
        i = i - 1;
        clean[i + pre] = clean[i];
    }
    clean[0] = MR_LT;
    clean[1] = MR_LT;
    clean[2] = MR_LT;
    if (pre == 4) { clean[3] = MR_SPACE; }
    var at: i32 = pre + len;
    if (post == 4) {
        clean[at] = MR_SPACE;
        at = at + 1;
    }
    clean[at] = MR_GT;
    clean[at + 1] = MR_GT;
    clean[at + 2] = MR_GT;
    return at + 3;
}

; Inline peer value: one line, marked. With max >= 0 a value longer than max UTF-16 units is cut and "..." shows the
; cut; max < 0 is no cut. The output is out[0 .. n).
pub fn mr_inline(input: [MR_TEXT_MAX]u8, len: i32, max: i32, out: [MR_OUT_MAX]u8) -> i32 {
    if (len < 0 or len > MR_TEXT_MAX) { return MR_ERR_LIMIT; }
    var n: i32 = mr_scrub(input, len, false, out);
    if (n < 0) { return n; }
    if (max >= 0) {
        var cut: i32 = mr_cut_units(out, n, max);
        if (cut < n) {
            if (!mr_room(cut, 3)) { return MR_ERR_LIMIT; }
            out[cut] = MR_DOT;
            out[cut + 1] = MR_DOT;
            out[cut + 2] = MR_DOT;
            n = cut + 3;
        }
    }
    return mr_wrap(out, n);
}

; Instance id as shown to the user: the first MR_ID_UNITS UTF-16 units, marked, then "...".
pub fn mr_id(input: [MR_TEXT_MAX]u8, len: i32, out: [MR_OUT_MAX]u8) -> i32 {
    if (len < 0 or len > MR_TEXT_MAX) { return MR_ERR_LIMIT; }
    var n: i32 = mr_scrub(input, len, false, out);
    if (n < 0) { return n; }
    var cut: i32 = mr_cut_units(out, n, MR_ID_UNITS);
    var wrapped: i32 = mr_wrap(out, cut);
    if (wrapped < 0) { return wrapped; }
    if (!mr_room(wrapped, 3)) { return MR_ERR_LIMIT; }
    out[wrapped] = MR_DOT;
    out[wrapped + 1] = MR_DOT;
    out[wrapped + 2] = MR_DOT;
    return wrapped + 3;
}

; Peer text with newlines, between two fence lines of its own: "<<<", a line feed, the clean text (line feeds and
; tabs stay), a line feed unless the text ends with one, and ">>>".
pub fn mr_block(input: [MR_TEXT_MAX]u8, len: i32, out: [MR_OUT_MAX]u8) -> i32 {
    if (len < 0 or len > MR_TEXT_MAX) { return MR_ERR_LIMIT; }
    var n: i32 = mr_scrub(input, len, true, out);
    if (n < 0) { return n; }
    var tail: i32 = 1;
    if (n > 0 and out[n - 1] == MR_LF) { tail = 0; }
    if (!mr_room(n, 4 + tail + 3)) { return MR_ERR_LIMIT; }
    var i: i32 = n;
    while (i > 0) {
        i = i - 1;
        out[i + 4] = out[i];
    }
    out[0] = MR_LT;
    out[1] = MR_LT;
    out[2] = MR_LT;
    out[3] = MR_LF;
    var at: i32 = 4 + n;
    if (tail == 1) {
        out[at] = MR_LF;
        at = at + 1;
    }
    out[at] = MR_GT;
    out[at + 1] = MR_GT;
    out[at + 2] = MR_GT;
    return at + 3;
}

; Does the text hold the fence mark "<<<"? Answers that carry marked peer text start with a header. A length that is
; not allowed: true, so the header is there.
pub fn mr_has_fence(text: [MR_TEXT_MAX]u8, len: i32) -> bool {
    if (len < 0 or len > MR_TEXT_MAX) { return true; }
    var i: i32 = 0;
    while (i + 3 <= len) {
        if (text[i] == MR_LT and text[i + 1] == MR_LT and text[i + 2] == MR_LT) { return true; }
        i = i + 1;
    }
    return false;
}

; The refusal text for a text over the size limit: "[peer text refused: over the size limit]". Written to out[0 .. 40).
pub fn mr_refusal(out: [MR_OUT_MAX]u8) -> i32 {
    var i: i32 = 0;
    while (i < MR_REFUSAL_LEN) {
        out[i] = MR_REFUSAL[i];
        i = i + 1;
    }
    return MR_REFUSAL_LEN;
}

var MR_T_IN : [MR_TEXT_MAX]u8 = [0; MR_TEXT_MAX];
var MR_T_OUT : [MR_OUT_MAX]u8 = [0; MR_OUT_MAX];

test mr_controls {
    assert mr_is_control(0, false) == true;
    assert mr_is_control(9, false) == true;
    assert mr_is_control(9, true) == false;
    assert mr_is_control(10, false) == true;
    assert mr_is_control(10, true) == false;
    assert mr_is_control(13, true) == true;
    assert mr_is_control(31, true) == true;
    assert mr_is_control(32, false) == false;
    assert mr_is_control(126, false) == false;
    assert mr_is_control(127, false) == true;
    assert mr_is_control(159, false) == true;
    assert mr_is_control(160, false) == false;
    assert mr_is_control(173, false) == true;
    assert mr_is_control(847, false) == true;
    assert mr_is_control(8202, false) == false;
    assert mr_is_control(8203, false) == true;
    assert mr_is_control(8207, false) == true;
    assert mr_is_control(8208, false) == false;
    assert mr_is_control(8232, false) == true;
    assert mr_is_control(8238, false) == true;
    assert mr_is_control(8239, false) == false;
    assert mr_is_control(8288, false) == true;
    assert mr_is_control(8293, false) == true;
    assert mr_is_control(8294, false) == true;
    assert mr_is_control(8297, false) == true;
    assert mr_is_control(8298, false) == false;
    assert mr_is_control(65279, false) == true;
    assert mr_is_control(65528, false) == false;
    assert mr_is_control(65529, false) == true;
    assert mr_is_control(65531, false) == true;
    assert mr_is_control(65532, false) == false;
    assert mr_is_control(917503, false) == false;
    assert mr_is_control(917504, false) == true;
    assert mr_is_control(917631, false) == true;
    assert mr_is_control(917632, false) == false;
}

test mr_scrub_fences {
    MR_T_IN[0] = 97;
    MR_T_IN[1] = 60;
    MR_T_IN[2] = 60;
    MR_T_IN[3] = 60;
    MR_T_IN[4] = 98;
    assert mr_scrub(MR_T_IN, 5, false, MR_T_OUT) == 6;
    assert MR_T_OUT[0] == 97;
    assert MR_T_OUT[1] == 60;
    assert MR_T_OUT[2] == 60;
    assert MR_T_OUT[3] == 32;
    assert MR_T_OUT[4] == 60;
    assert MR_T_OUT[5] == 98;
    MR_T_IN[0] = 62;
    MR_T_IN[1] = 62;
    MR_T_IN[2] = 62;
    MR_T_IN[3] = 62;
    assert mr_scrub(MR_T_IN, 4, false, MR_T_OUT) == 5;
    assert MR_T_OUT[2] == 32;
    assert mr_scrub(MR_T_IN, 0, false, MR_T_OUT) == 0;
    assert mr_scrub(MR_T_IN, -1, false, MR_T_OUT) == MR_ERR_LIMIT;
    assert mr_scrub(MR_T_IN, 3145729, false, MR_T_OUT) == MR_ERR_LIMIT;
}

test mr_scrub_controls_and_utf8 {
    MR_T_IN[0] = 120;
    MR_T_IN[1] = 226;
    MR_T_IN[2] = 128;
    MR_T_IN[3] = 139;
    MR_T_IN[4] = 10;
    MR_T_IN[5] = 121;
    assert mr_scrub(MR_T_IN, 6, false, MR_T_OUT) == 4;
    assert MR_T_OUT[1] == 32;
    assert MR_T_OUT[2] == 32;
    assert MR_T_OUT[3] == 121;
    assert mr_scrub(MR_T_IN, 6, true, MR_T_OUT) == 4;
    assert MR_T_OUT[1] == 32;
    assert MR_T_OUT[2] == 10;
    MR_T_IN[0] = 240;
    MR_T_IN[1] = 159;
    MR_T_IN[2] = 152;
    MR_T_IN[3] = 128;
    assert mr_scrub(MR_T_IN, 4, false, MR_T_OUT) == 4;
    assert MR_T_OUT[0] == 240;
    assert MR_T_OUT[3] == 128;
    assert mr_scrub(MR_T_IN, 3, false, MR_T_OUT) == MR_ERR_TEXT;
    MR_T_IN[0] = 128;
    assert mr_scrub(MR_T_IN, 1, false, MR_T_OUT) == MR_ERR_TEXT;
    MR_T_IN[0] = 192;
    MR_T_IN[1] = 128;
    assert mr_scrub(MR_T_IN, 2, false, MR_T_OUT) == MR_ERR_TEXT;
    MR_T_IN[0] = 237;
    MR_T_IN[1] = 160;
    MR_T_IN[2] = 128;
    assert mr_scrub(MR_T_IN, 3, false, MR_T_OUT) == MR_ERR_TEXT;
    MR_T_IN[0] = 244;
    MR_T_IN[1] = 144;
    MR_T_IN[2] = 128;
    MR_T_IN[3] = 128;
    assert mr_scrub(MR_T_IN, 4, false, MR_T_OUT) == MR_ERR_TEXT;
    MR_T_IN[0] = 224;
    MR_T_IN[1] = 159;
    MR_T_IN[2] = 128;
    assert mr_scrub(MR_T_IN, 3, false, MR_T_OUT) == MR_ERR_TEXT;
    MR_T_IN[0] = 255;
    assert mr_scrub(MR_T_IN, 1, false, MR_T_OUT) == MR_ERR_TEXT;
}

test mr_cut_and_wrap {
    MR_T_OUT[0] = 120;
    MR_T_OUT[1] = 240;
    MR_T_OUT[2] = 159;
    MR_T_OUT[3] = 152;
    MR_T_OUT[4] = 128;
    MR_T_OUT[5] = 121;
    assert mr_cut_units(MR_T_OUT, 6, 0) == 0;
    assert mr_cut_units(MR_T_OUT, 6, 1) == 1;
    assert mr_cut_units(MR_T_OUT, 6, 2) == 1;
    assert mr_cut_units(MR_T_OUT, 6, 3) == 5;
    assert mr_cut_units(MR_T_OUT, 6, 4) == 6;
    assert mr_cut_units(MR_T_OUT, 6, 9) == 6;
    assert mr_cut_units(MR_T_OUT, 6, -1) == MR_ERR_LIMIT;
    assert mr_cut_units(MR_T_OUT, 0, 5) == 0;
    MR_T_OUT[0] = 60;
    MR_T_OUT[1] = 97;
    MR_T_OUT[2] = 62;
    assert mr_wrap(MR_T_OUT, 3) == 11;
    assert MR_T_OUT[0] == 60;
    assert MR_T_OUT[2] == 60;
    assert MR_T_OUT[3] == 32;
    assert MR_T_OUT[4] == 60;
    assert MR_T_OUT[5] == 97;
    assert MR_T_OUT[6] == 62;
    assert MR_T_OUT[7] == 32;
    assert MR_T_OUT[8] == 62;
    assert MR_T_OUT[9] == 62;
    assert mr_wrap(MR_T_OUT, 0) == 6;
    assert MR_T_OUT[2] == 60;
    assert MR_T_OUT[3] == 62;
    assert MR_T_OUT[5] == 62;
    assert mr_wrap(MR_T_OUT, -1) == MR_ERR_LIMIT;
    assert mr_wrap(MR_T_OUT, 4718609) == MR_ERR_LIMIT;
}

test mr_inline_id_block {
    MR_T_IN[0] = 97;
    MR_T_IN[1] = 98;
    MR_T_IN[2] = 99;
    MR_T_IN[3] = 100;
    assert mr_inline(MR_T_IN, 4, -1, MR_T_OUT) == 10;
    assert MR_T_OUT[3] == 97;
    assert MR_T_OUT[6] == 100;
    assert mr_inline(MR_T_IN, 4, 4, MR_T_OUT) == 10;
    assert mr_inline(MR_T_IN, 4, 2, MR_T_OUT) == 11;
    assert MR_T_OUT[3] == 97;
    assert MR_T_OUT[4] == 98;
    assert MR_T_OUT[5] == 46;
    assert MR_T_OUT[7] == 46;
    assert MR_T_OUT[8] == 62;
    assert mr_inline(MR_T_IN, 4, 0, MR_T_OUT) == 9;
    assert MR_T_OUT[3] == 46;
    assert mr_id(MR_T_IN, 4, MR_T_OUT) == 13;
    assert MR_T_OUT[3] == 97;
    assert MR_T_OUT[7] == 62;
    assert MR_T_OUT[10] == 46;
    assert MR_T_OUT[12] == 46;
    assert mr_block(MR_T_IN, 4, MR_T_OUT) == 12;
    assert MR_T_OUT[3] == 10;
    assert MR_T_OUT[4] == 97;
    assert MR_T_OUT[8] == 10;
    assert MR_T_OUT[9] == 62;
    MR_T_IN[3] = 10;
    assert mr_block(MR_T_IN, 4, MR_T_OUT) == 11;
    assert MR_T_OUT[7] == 10;
    assert MR_T_OUT[8] == 62;
    assert mr_block(MR_T_IN, 0, MR_T_OUT) == 8;
    assert MR_T_OUT[4] == 10;
    assert MR_T_OUT[5] == 62;
    assert mr_inline(MR_T_IN, -1, -1, MR_T_OUT) == MR_ERR_LIMIT;
    assert mr_id(MR_T_IN, 3145729, MR_T_OUT) == MR_ERR_LIMIT;
    assert mr_block(MR_T_IN, -5, MR_T_OUT) == MR_ERR_LIMIT;
}

test mr_fence_and_refusal {
    MR_T_IN[0] = 97;
    MR_T_IN[1] = 60;
    MR_T_IN[2] = 60;
    MR_T_IN[3] = 60;
    MR_T_IN[4] = 98;
    assert mr_has_fence(MR_T_IN, 5) == true;
    assert mr_has_fence(MR_T_IN, 4) == true;
    assert mr_has_fence(MR_T_IN, 3) == false;
    assert mr_has_fence(MR_T_IN, 0) == false;
    assert mr_has_fence(MR_T_IN, -1) == true;
    assert mr_has_fence(MR_T_IN, 3145729) == true;
    assert mr_refusal(MR_T_OUT) == 40;
    assert MR_T_OUT[0] == 91;
    assert MR_T_OUT[39] == 93;
}
