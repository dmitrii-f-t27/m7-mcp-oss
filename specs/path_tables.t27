; Name tables of the path rules. GENERATED by specs/tables/path_tables.mjs from the name lists of
; src/core/security/pathGuard.ts at c41f8ce. Do not edit this file: change the lists in
; specs/tables/path_tables.mjs and run specs/generate.sh.
; Cross-spec calls take scalars only, so the names are one byte table and the functions below answer
; with numbers: how many names table t has (pt_count), where name i of table t starts and ends in the
; byte table (pt_start, pt_end) and the byte at a place (pt_byte). A wrong table or index answers -1.
module PathTables;

pub const PT_SECRET_NAMES : i32 = 0;
pub const PT_SECRET_PREFIXES : i32 = 1;
pub const PT_SECRET_SUFFIXES : i32 = 2;
pub const PT_CONTROL_NAMES : i32 = 3;
pub const PT_TABLES : i32 = 4;
pub const PT_ENTRIES : i32 = 43;
pub const PT_BYTES_LEN : i32 = 314;

; The names one after the other, without separators.
pub const PT_BYTES : [314]u8 = [
    46, 101, 110, 118, 46, 101, 110, 118, 114, 99, 46, 110, 112, 109, 114, 99, 46, 110, 101, 116,
    114, 99, 46, 112, 121, 112, 105, 114, 99, 46, 112, 103, 112, 97, 115, 115, 46, 103, 105, 116,
    45, 99, 114, 101, 100, 101, 110, 116, 105, 97, 108, 115, 105, 100, 95, 114, 115, 97, 105, 100,
    95, 100, 115, 97, 105, 100, 95, 101, 99, 100, 115, 97, 105, 100, 95, 101, 100, 50, 53, 53,
    49, 57, 99, 114, 101, 100, 101, 110, 116, 105, 97, 108, 115, 46, 97, 119, 115, 46, 115, 115,
    104, 46, 100, 111, 99, 107, 101, 114, 46, 107, 117, 98, 101, 46, 103, 110, 117, 112, 103, 46,
    101, 110, 118, 46, 46, 107, 101, 121, 46, 112, 101, 109, 46, 112, 49, 50, 46, 112, 102, 120,
    46, 106, 107, 115, 46, 107, 101, 121, 115, 116, 111, 114, 101, 46, 101, 110, 118, 46, 103, 105,
    116, 46, 99, 117, 114, 115, 111, 114, 46, 99, 117, 114, 115, 111, 114, 114, 117, 108, 101, 115,
    46, 118, 115, 99, 111, 100, 101, 46, 99, 108, 97, 117, 100, 101, 46, 109, 55, 46, 104, 117,
    115, 107, 121, 46, 103, 105, 116, 104, 117, 98, 46, 109, 99, 112, 46, 106, 115, 111, 110, 99,
    108, 97, 117, 100, 101, 46, 109, 100, 97, 103, 101, 110, 116, 115, 46, 109, 100, 103, 101, 109,
    105, 110, 105, 46, 109, 100, 46, 99, 108, 105, 110, 101, 114, 117, 108, 101, 115, 46, 119, 105,
    110, 100, 115, 117, 114, 102, 114, 117, 108, 101, 115, 46, 100, 101, 118, 99, 111, 110, 116, 97,
    105, 110, 101, 114, 46, 105, 100, 101, 97, 46, 103, 105, 116, 109, 111, 100, 117, 108, 101, 115,
    46, 103, 105, 116, 97, 116, 116, 114, 105, 98, 117, 116, 101, 115
];

; Where each name starts in PT_BYTES; the last entry is the end of the last name.
pub const PT_BOUNDS : [44]i32 = [
    0, 4, 10, 16, 22, 29, 36, 52, 58, 64, 72, 82, 93, 97, 101, 108, 113, 119, 124, 128,
    132, 136, 140, 144, 153, 157, 161, 168, 180, 187, 194, 197, 203, 210, 219, 228, 237, 246, 257, 271,
    284, 289, 300, 314
];

; The index of the first name of each table in PT_BOUNDS; the last entry is PT_ENTRIES.
pub const PT_FIRST : [5]i32 = [0, 17, 18, 25, 43];

pub fn pt_count(t: i32) -> i32 {
    if (t < 0 or t >= PT_TABLES) { return 0; }
    return PT_FIRST[t + 1] - PT_FIRST[t];
}

pub fn pt_start(t: i32, i: i32) -> i32 {
    if (i < 0 or i >= pt_count(t)) { return -1; }
    return PT_BOUNDS[PT_FIRST[t] + i];
}

pub fn pt_end(t: i32, i: i32) -> i32 {
    if (i < 0 or i >= pt_count(t)) { return -1; }
    return PT_BOUNDS[PT_FIRST[t] + i + 1];
}

pub fn pt_byte(p: i32) -> u8 {
    if (p < 0 or p >= PT_BYTES_LEN) { return 0; }
    return PT_BYTES[p];
}

test pt_tables_shape {
    assert pt_count(PT_SECRET_NAMES) == 17;
    assert pt_count(PT_SECRET_PREFIXES) == 1;
    assert pt_count(PT_SECRET_SUFFIXES) == 7;
    assert pt_count(PT_CONTROL_NAMES) == 18;
    assert pt_count(-1) == 0;
    assert pt_count(PT_TABLES) == 0;
    assert pt_start(PT_SECRET_NAMES, 0) == 0;
    assert pt_end(PT_SECRET_NAMES, 0) == 4;
    assert pt_start(PT_SECRET_NAMES, -1) == -1;
    assert pt_start(PT_SECRET_NAMES, 17) == -1;
    assert pt_end(PT_CONTROL_NAMES, 18) == -1;
    assert pt_end(PT_CONTROL_NAMES, 17) == PT_BYTES_LEN;
    assert pt_byte(0) == 46;
    assert pt_byte(-1) == 0;
    assert pt_byte(PT_BYTES_LEN) == 0;
}
