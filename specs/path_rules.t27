// Added by Dmitrii Fedorov, 2026; not part of the original M7 MCP. Apache-2.0 (see NOTICE).
; Path rules, moved from src/core/security/pathGuard.ts and src/core/utils/projectPath.ts. The TypeScript at
; c41f8ce stays as the test oracle (tests/oracles/pathGuardLegacy.mjs, projectPathLegacy.mjs).
; Text is UTF-8 bytes in a buffer, always with its true length. A length below 0 or over the limit is
; refused (a bad length answers the refusing value of the function), never cut. The host (src/rules/pathRules.ts)
; does what t27 does not do: Unicode folding of each segment, resolve(), file system calls.
; Cross-spec calls: bytes_rules (single bytes) and path_tables (scalars), through headers included first.
module PathRules;

pub const PR_PATH_MAX : i32 = 4096;
pub const PR_FOLDED_MAX : i32 = 16384;

; Answers of pr_push_verdict and pr_pull_verdict. A bad length answers -1.
pub const PR_VERDICT_OK : i32 = 0;
pub const PR_VERDICT_SECRET : i32 = 1;
pub const PR_VERDICT_CONTROL : i32 = 2;

; Answers of pr_env_source, in the order of selectProjectSource.
pub const PR_SRC_CURSOR_ENV : i32 = 0;
pub const PR_SRC_AGENT_TRANSCRIPTS : i32 = 1;
pub const PR_SRC_M7_PROJECT_PATH : i32 = 2;
pub const PR_SRC_CURSOR_PROJECTS_DIR : i32 = 3;
pub const PR_SRC_PROCESS_CWD : i32 = 4;

; Table numbers of path_tables, and how a segment is compared with a name.
pub const PR_T_SECRET_NAMES : i32 = 0;
pub const PR_T_SECRET_PREFIXES : i32 = 1;
pub const PR_T_SECRET_SUFFIXES : i32 = 2;
pub const PR_T_CONTROL_NAMES : i32 = 3;
pub const PR_MATCH_EQUALS : i32 = 0;
pub const PR_MATCH_STARTS : i32 = 1;
pub const PR_MATCH_ENDS : i32 = 2;

pub const PR_DOT : u8 = 46;
pub const PR_SPACE : u8 = 32;

; True when the text holds a NUL byte, or when its length is not allowed (refuse).
pub fn pr_has_nul(buf: [PR_FOLDED_MAX]u8, len: i32) -> bool {
    if (len < 0 or len > PR_FOLDED_MAX) { return true; }
    var i: i32 = 0;
    while (i < len) {
        if (buf[i] == 0) { return true; }
        i = i + 1;
    }
    return false;
}

; The start of the next path segment at or after pos: the first byte that is not a "/" or a "\".
; -1: no more segments. -2: the length or the position is not allowed.
pub fn pr_seg_start(buf: [PR_PATH_MAX]u8, len: i32, pos: i32) -> i32 {
    if (len < 0 or len > PR_PATH_MAX or pos < 0 or pos > len) { return -2; }
    var i: i32 = pos;
    while (i < len) {
        if (!by_is_sep(buf[i], true)) { return i; }
        i = i + 1;
    }
    return -1;
}

; The end of the segment that starts at start: the first "/" or "\" after it, or len. -2: not allowed.
pub fn pr_seg_end(buf: [PR_PATH_MAX]u8, len: i32, start: i32) -> i32 {
    if (len < 0 or len > PR_PATH_MAX or start < 0 or start >= len) { return -2; }
    var i: i32 = start;
    while (i < len) {
        if (by_is_sep(buf[i], true)) { return i; }
        i = i + 1;
    }
    return len;
}

; The length without trailing dots and spaces. Windows and some network file systems ignore them in a name.
; -1: the length is not allowed. The result is for comparison only.
pub fn pr_trim_end(buf: [PR_FOLDED_MAX]u8, len: i32) -> i32 {
    if (len < 0 or len > PR_FOLDED_MAX) { return -1; }
    var end: i32 = len;
    while (end > 0) {
        if (buf[end - 1] != PR_DOT and buf[end - 1] != PR_SPACE) { return end; }
        end = end - 1;
    }
    return end;
}

; Does the segment buf[a..b) match name i of table t? How: equals, starts with, ends with.
; A table that does not answer, or a name that is empty, counts as a match: the answer is then "refuse".
fn pr_matches(buf: [PR_FOLDED_MAX]u8, a: i32, b: i32, t: i32, i: i32, how: i32) -> bool {
    var s: i32 = pt_start(t, i);
    var e: i32 = pt_end(t, i);
    if (s < 0 or e <= s) { return true; }
    var n: i32 = e - s;
    var m: i32 = b - a;
    if (how == PR_MATCH_EQUALS and m != n) { return false; }
    if (m < n) { return false; }
    var from: i32 = a;
    if (how == PR_MATCH_ENDS) { from = b - n; }
    var k: i32 = 0;
    while (k < n) {
        if (buf[from + k] != pt_byte(s + k)) { return false; }
        k = k + 1;
    }
    return true;
}

; Does the segment buf[a..b) match any name of table t in the given way?
fn pr_matches_any(buf: [PR_FOLDED_MAX]u8, a: i32, b: i32, t: i32, how: i32) -> bool {
    var n: i32 = pt_count(t);
    var i: i32 = 0;
    while (i < n) {
        if (pr_matches(buf, a, b, t, i, how)) { return true; }
        i = i + 1;
    }
    return false;
}

; A segment of folded text that holds secrets: a secret name, a name that starts with ".env.", or one that
; ends with ".key", ".pem", ".p12", ".pfx", ".jks", ".keystore" or ".env".
fn pr_is_secret(buf: [PR_FOLDED_MAX]u8, a: i32, b: i32) -> bool {
    if (pr_matches_any(buf, a, b, PR_T_SECRET_NAMES, PR_MATCH_EQUALS)) { return true; }
    if (pr_matches_any(buf, a, b, PR_T_SECRET_PREFIXES, PR_MATCH_STARTS)) { return true; }
    if (pr_matches_any(buf, a, b, PR_T_SECRET_SUFFIXES, PR_MATCH_ENDS)) { return true; }
    return false;
}

; Does any segment of the joined text hold secrets (control = false) or steer git, editors, agents or M7
; (control = true)? The joined text is the folded segments, each followed by a NUL byte. An empty segment
; matches nothing.
fn pr_any_segment(joined: [PR_FOLDED_MAX]u8, len: i32, control: bool) -> bool {
    var a: i32 = 0;
    while (a < len) {
        var b: i32 = a;
        while (b < len and joined[b] != 0) { b = b + 1; }
        if (control) {
            if (b > a and pr_matches_any(joined, a, b, PR_T_CONTROL_NAMES, PR_MATCH_EQUALS)) { return true; }
        } else {
            if (b > a and pr_is_secret(joined, a, b)) { return true; }
        }
        a = b + 1;
    }
    return false;
}

; Verdict for a path that must not be pushed to a peer: PR_VERDICT_OK or PR_VERDICT_SECRET. -1: bad length.
pub fn pr_push_verdict(joined: [PR_FOLDED_MAX]u8, len: i32) -> i32 {
    if (len < 0 or len > PR_FOLDED_MAX) { return -1; }
    if (pr_any_segment(joined, len, false)) { return PR_VERDICT_SECRET; }
    return PR_VERDICT_OK;
}

; Verdict for a path that must not be written into the project: PR_VERDICT_OK, PR_VERDICT_SECRET or
; PR_VERDICT_CONTROL. Secrets are looked for in all segments first. -1: bad length.
pub fn pr_pull_verdict(joined: [PR_FOLDED_MAX]u8, len: i32) -> i32 {
    if (len < 0 or len > PR_FOLDED_MAX) { return -1; }
    if (pr_any_segment(joined, len, false)) { return PR_VERDICT_SECRET; }
    if (pr_any_segment(joined, len, true)) { return PR_VERDICT_CONTROL; }
    return PR_VERDICT_OK;
}

; True when target is root or lies below it: equal, or root plus a separator as prefix. A bare prefix is not
; enough ("/a/b-evil" is not inside "/a/b"). win turns on the Windows reading: both separators, ASCII case
; does not matter. A bad length or an empty root: false.
pub fn pr_is_inside(root: [PR_PATH_MAX]u8, root_len: i32, target: [PR_PATH_MAX]u8, target_len: i32, win: bool) -> bool {
    if (root_len <= 0 or root_len > PR_PATH_MAX or target_len < 0 or target_len > PR_PATH_MAX) { return false; }
    if (target_len < root_len) { return false; }
    var i: i32 = 0;
    while (i < root_len) {
        var x: u8 = root[i];
        var y: u8 = target[i];
        if (x != y) {
            var same: bool = false;
            if (win) {
                if (by_is_sep(x, true) and by_is_sep(y, true)) { same = true; }
                if (by_fold_ascii(x) == by_fold_ascii(y)) { same = true; }
            }
            if (!same) { return false; }
        }
        i = i + 1;
    }
    if (target_len == root_len) { return true; }
    if (by_is_sep(root[root_len - 1], win)) { return true; }
    return by_is_sep(target[root_len], win);
}

; Where target continues after root and the separators that follow it, when target is inside root;
; -1 when it is not (or a length is not allowed).
pub fn pr_relative_start(root: [PR_PATH_MAX]u8, root_len: i32, target: [PR_PATH_MAX]u8, target_len: i32, win: bool) -> i32 {
    if (root_len <= 0 or root_len > PR_PATH_MAX or target_len < 0 or target_len > PR_PATH_MAX) { return -1; }
    if (!pr_is_inside(root, root_len, target, target_len, win)) { return -1; }
    var i: i32 = root_len;
    while (i < target_len and by_is_sep(target[i], win)) { i = i + 1; }
    return i;
}

; A symbolic link leaves the root when its target is missing (it can be created later) or not inside.
pub fn pr_link_leaves(real_null: bool, inside: bool) -> bool {
    if (real_null) { return true; }
    if (inside) { return false; }
    return true;
}

; A name that can be joined to a folder: not empty, not "." or "..", no NUL byte. A bad length: false.
pub fn pr_plain_entry_name(name: [PR_PATH_MAX]u8, len: i32) -> bool {
    if (len <= 0 or len > PR_PATH_MAX) { return false; }
    if (len == 1 and name[0] == PR_DOT) { return false; }
    if (len == 2 and name[0] == PR_DOT and name[1] == PR_DOT) { return false; }
    var i: i32 = 0;
    while (i < len) {
        if (name[i] == 0) { return false; }
        i = i + 1;
    }
    return true;
}

; Which source answers after explicit project_path and MCP Roots. PR_SRC_CURSOR_PROJECTS_DIR means "try the
; scan"; PR_SRC_PROCESS_CWD is also the answer while M7_PROJECT_PATH waits for the Roots step.
pub fn pr_env_source(has_cursor: bool, has_transcripts: bool, has_m7: bool, roots_complete: bool, cwd_allows_scan: bool) -> i32 {
    if (has_cursor) { return PR_SRC_CURSOR_ENV; }
    if (has_transcripts) { return PR_SRC_AGENT_TRANSCRIPTS; }
    if (has_m7) {
        if (roots_complete) { return PR_SRC_M7_PROJECT_PATH; }
        return PR_SRC_PROCESS_CWD;
    }
    if (cwd_allows_scan) { return PR_SRC_CURSOR_PROJECTS_DIR; }
    return PR_SRC_PROCESS_CWD;
}

; Must a subscriber that works on cur switch to nxt? Both are resolved paths. No current path: yes. The same
; text: no. A bad length: yes.
pub fn pr_needs_switch(has_current: bool, cur: [PR_PATH_MAX]u8, cur_len: i32, nxt: [PR_PATH_MAX]u8, nxt_len: i32) -> bool {
    if (cur_len < 0 or cur_len > PR_PATH_MAX or nxt_len < 0 or nxt_len > PR_PATH_MAX) { return true; }
    if (!has_current) { return true; }
    if (cur_len != nxt_len) { return true; }
    var i: i32 = 0;
    while (i < cur_len) {
        if (cur[i] != nxt[i]) { return true; }
        i = i + 1;
    }
    return false;
}

; The home folder is not a project unless it holds a project marker.
pub fn pr_unsafe_fallback(is_home: bool, is_valid: bool) -> bool {
    if (is_home and !is_valid) { return true; }
    return false;
}

var PR_T1 : [PR_FOLDED_MAX]u8 = [0; PR_FOLDED_MAX];
var PR_T2 : [PR_FOLDED_MAX]u8 = [0; PR_FOLDED_MAX];

test pr_seg_split {
    PR_T1[0] = 47;
    PR_T1[1] = 97;
    PR_T1[2] = 92;
    PR_T1[3] = 92;
    PR_T1[4] = 98;
    PR_T1[5] = 99;
    assert pr_seg_start(PR_T1, 6, 0) == 1;
    assert pr_seg_end(PR_T1, 6, 1) == 2;
    assert pr_seg_start(PR_T1, 6, 2) == 4;
    assert pr_seg_end(PR_T1, 6, 4) == 6;
    assert pr_seg_start(PR_T1, 6, 6) == -1;
    assert pr_seg_start(PR_T1, 1, 0) == -1;
    assert pr_seg_start(PR_T1, 6, 7) == -2;
    assert pr_seg_start(PR_T1, -1, 0) == -2;
    assert pr_seg_start(PR_T1, 4097, 0) == -2;
    assert pr_seg_end(PR_T1, 6, 6) == -2;
}

test pr_nul_and_trim {
    PR_T1[0] = 97;
    PR_T1[1] = 46;
    PR_T1[2] = 32;
    PR_T1[3] = 46;
    assert pr_has_nul(PR_T1, 4) == false;
    assert pr_has_nul(PR_T1, 0) == false;
    PR_T1[2] = 0;
    assert pr_has_nul(PR_T1, 4) == true;
    assert pr_has_nul(PR_T1, 2) == false;
    assert pr_has_nul(PR_T1, -1) == true;
    assert pr_has_nul(PR_T1, 16385) == true;
    PR_T1[2] = 32;
    assert pr_trim_end(PR_T1, 4) == 1;
    assert pr_trim_end(PR_T1, 1) == 1;
    assert pr_trim_end(PR_T1, 0) == 0;
    assert pr_trim_end(PR_T1, -1) == -1;
    assert pr_trim_end(PR_T1, 16385) == -1;
}

test pr_verdicts {
    PR_T1[0] = 46;
    PR_T1[1] = 101;
    PR_T1[2] = 110;
    PR_T1[3] = 118;
    PR_T1[4] = 0;
    assert pr_push_verdict(PR_T1, 5) == PR_VERDICT_SECRET;
    assert pr_pull_verdict(PR_T1, 5) == PR_VERDICT_SECRET;
    assert pr_push_verdict(PR_T1, 4) == PR_VERDICT_SECRET;
    assert pr_push_verdict(PR_T1, 3) == PR_VERDICT_OK;
    PR_T1[0] = 46;
    PR_T1[1] = 103;
    PR_T1[2] = 105;
    PR_T1[3] = 116;
    PR_T1[4] = 0;
    assert pr_push_verdict(PR_T1, 5) == PR_VERDICT_OK;
    assert pr_pull_verdict(PR_T1, 5) == PR_VERDICT_CONTROL;
    PR_T1[0] = 97;
    PR_T1[1] = 0;
    PR_T1[2] = 0;
    PR_T1[3] = 98;
    PR_T1[4] = 0;
    assert pr_pull_verdict(PR_T1, 5) == PR_VERDICT_OK;
    assert pr_pull_verdict(PR_T1, 0) == PR_VERDICT_OK;
    assert pr_push_verdict(PR_T1, -1) == -1;
    assert pr_pull_verdict(PR_T1, 16385) == -1;
}

test pr_inside {
    PR_T1[0] = 47;
    PR_T1[1] = 97;
    PR_T2[0] = 47;
    PR_T2[1] = 97;
    PR_T2[2] = 47;
    PR_T2[3] = 98;
    assert pr_is_inside(PR_T1, 2, PR_T2, 4, false) == true;
    assert pr_is_inside(PR_T1, 2, PR_T2, 2, false) == true;
    assert pr_is_inside(PR_T1, 2, PR_T2, 3, false) == true;
    PR_T2[2] = 98;
    assert pr_is_inside(PR_T1, 2, PR_T2, 4, false) == false;
    assert pr_is_inside(PR_T1, 0, PR_T2, 4, false) == false;
    assert pr_is_inside(PR_T1, 2, PR_T2, 1, false) == false;
    assert pr_is_inside(PR_T1, 2, PR_T2, 4097, false) == false;
    assert pr_is_inside(PR_T1, 4097, PR_T2, 4, false) == false;
    PR_T2[0] = 47;
    PR_T2[1] = 65;
    PR_T2[2] = 92;
    PR_T2[3] = 98;
    assert pr_is_inside(PR_T1, 2, PR_T2, 4, false) == false;
    assert pr_is_inside(PR_T1, 2, PR_T2, 4, true) == true;
    assert pr_relative_start(PR_T1, 2, PR_T2, 4, true) == 3;
    assert pr_relative_start(PR_T1, 2, PR_T2, 4, false) == -1;
    assert pr_relative_start(PR_T1, 2, PR_T2, 2, true) == 2;
    assert pr_relative_start(PR_T1, 0, PR_T2, 2, true) == -1;
}

test pr_small_rules {
    assert pr_link_leaves(true, true) == true;
    assert pr_link_leaves(true, false) == true;
    assert pr_link_leaves(false, true) == false;
    assert pr_link_leaves(false, false) == true;
    assert pr_unsafe_fallback(true, false) == true;
    assert pr_unsafe_fallback(true, true) == false;
    assert pr_unsafe_fallback(false, false) == false;
    assert pr_unsafe_fallback(false, true) == false;
    assert pr_env_source(true, true, true, true, true) == PR_SRC_CURSOR_ENV;
    assert pr_env_source(false, true, true, true, true) == PR_SRC_AGENT_TRANSCRIPTS;
    assert pr_env_source(false, false, true, true, true) == PR_SRC_M7_PROJECT_PATH;
    assert pr_env_source(false, false, true, false, true) == PR_SRC_PROCESS_CWD;
    assert pr_env_source(false, false, false, false, true) == PR_SRC_CURSOR_PROJECTS_DIR;
    assert pr_env_source(false, false, false, true, false) == PR_SRC_PROCESS_CWD;
}

test pr_names_and_switch {
    PR_T1[0] = 46;
    PR_T1[1] = 46;
    assert pr_plain_entry_name(PR_T1, 0) == false;
    assert pr_plain_entry_name(PR_T1, 1) == false;
    assert pr_plain_entry_name(PR_T1, 2) == false;
    assert pr_plain_entry_name(PR_T1, 4097) == false;
    PR_T1[1] = 97;
    assert pr_plain_entry_name(PR_T1, 2) == true;
    PR_T1[1] = 0;
    assert pr_plain_entry_name(PR_T1, 2) == false;
    PR_T1[0] = 47;
    PR_T1[1] = 97;
    PR_T2[0] = 47;
    PR_T2[1] = 97;
    assert pr_needs_switch(false, PR_T1, 0, PR_T2, 2) == true;
    assert pr_needs_switch(true, PR_T1, 2, PR_T2, 2) == false;
    assert pr_needs_switch(true, PR_T1, 2, PR_T2, 1) == true;
    PR_T2[1] = 98;
    assert pr_needs_switch(true, PR_T1, 2, PR_T2, 2) == true;
    assert pr_needs_switch(true, PR_T1, -1, PR_T2, 2) == true;
    assert pr_needs_switch(true, PR_T1, 2, PR_T2, 4097) == true;
}
